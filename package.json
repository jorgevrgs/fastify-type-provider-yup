{
  "name": "fastify-type-provider-yup",
  "version": "5.1.1",
  "description": "Yup type provider for Fastify v5",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm test:js && pnpm test:ts",
    "test:watch": "vitest --watch",
    "test:cov": "vitest run --coverage",
    "test:js": "vitest",
    "test:ts": "vitest --typecheck",
    "example:ts": "nodemon --exec node --loader ts-node/esm --inspect examples/plugin-swagger.example.ts",
    "prepare": "husky"
  },
  "keywords": [
    "fastify",
    "yup",
    "type-providers",
    "schemas",
    "validation",
    "serialization"
  ],
  "author": "Jorge Vargas <jorgevargasla@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "1.8.2",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@types/json-schema": "^7.0.15",
    "@vitest/coverage-v8": "^3.2.4",
    "fastify": "^5.6.0",
    "fastify-type-provider-zod": "^6.0.0",
    "husky": "^9.1.7",
    "json-schema": "^0.4.0",
    "lint-staged": "^16.2.7",
    "pino-pretty": "^13.1.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yup": "^1.7.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "fastify": "^5.0.0",
    "yup": "^1.7.0"
  },
  "dependencies": {
    "@fastify/error": "^4.2.0",
    "@sodaru/yup-to-json-schema": "^2.0.1",
    "fastify-plugin": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jorgevrgs/fastify-type-provider-yup"
  },
  "bugs": {
    "url": "https://github.com/jorgevrgs/fastify-type-provider-yup/issues"
  },
  "homepage": "https://github.com/jorgevrgs/fastify-type-provider-yup#readme",
  "files": ["dist"]
}
