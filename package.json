{
  "name": "fastify-type-provider-yup",
  "version": "5.0.0",
  "description": "Yup type provider for Fastify v5",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "pnpm build:esm && pnpm build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "dev:cjs": "tsc-watch --noClear -p ./tsconfig.cjs.json --onSuccess \"node ./examples/plugin-common.example.cjs\"",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "test": "pnpm test:js && pnpm test:ts",
    "test:watch": "vitest --watch",
    "test:cov": "vitest run --coverage",
    "test:js": "vitest",
    "test:ts": "vitest --typecheck",
    "example:node": "node examples/plugin-module.example.mjs",
    "example:ts": "nodemon --exec node --loader ts-node/esm --inspect examples/plugin-swagger.example.ts"
  },
  "keywords": [
    "fastify",
    "yup",
    "type-providers",
    "schemas",
    "validation",
    "serialization"
  ],
  "author": "Jorge Vargas <jorgevargasla@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@biomejs/biome": "1.8.2",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@tsconfig/node-lts": "^22.0.2",
    "@types/json-schema": "^7.0.15",
    "@vitest/coverage-v8": "^3.2.4",
    "fastify": "^5.6.0",
    "fastify-type-provider-zod": "^6.0.0",
    "json-schema": "^0.4.0",
    "pino-pretty": "^13.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yup": "^1.7.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "fastify": "^5.0.0",
    "yup": "^1.7.0"
  },
  "dependencies": {
    "@sodaru/yup-to-json-schema": "^2.0.1",
    "fastify-plugin": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jorgevrgs/fastify-type-provider-yup"
  },
  "bugs": {
    "url": "https://github.com/jorgevrgs/fastify-type-provider-yup/issues"
  },
  "homepage": "https://github.com/jorgevrgs/fastify-type-provider-yup#readme",
  "files": ["dist"]
}
